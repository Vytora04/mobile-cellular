{
  "name": "mobile-cellular",
  "version": "1.0.0",
  "description": "CLI / API Service untuk memonitor pulsa, masa aktif, dan kuota operator seluler (Telkomsel, Tri, Indosat)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:web": "vite",
    "login": "tsx src/index.ts --login",
    "login:browser": "tsx src/browser_login.ts",
    "build": "tsc",
    "build:web": "vite build",
    "cap:sync": "vite build && cap sync android",
    "cap:open": "cap open android",
    "start": "tsx src/index.ts"
  },
  "keywords": [
    "cellular",
    "quota",
    "telkomsel",
    "tri",
    "indosat",
    "quota-checker",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "js-sha512": "^0.9.0",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.13.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.6"
  }
}
